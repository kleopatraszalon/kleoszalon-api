# Auth
JWT_SECRET=change_me
CODE_EXPIRES_MIN=10

# CORS
CORS_ORIGIN=http://localhost:5173

# DB
DATABASE_URL=postgres://user:pass@host:5432/dbname
PG_TIMEZONE=Europe/Budapest

# Mail / VIR internal e-mail
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=strong_password
SMTP_FROM="Kleopátra Szalon <noreply@kleoszalon.hu>"
# If SMTP preflight fails, booking mail stays pending without consuming retry attempts.
BOOKING_PROVIDER_RECHECK_MINUTES=30

# Mailchimp franchise lead funnel
# Keep the API key server-side only. The frontend never receives it.
# These remain supported as Render/bootstrap fallbacks. VIR > Beállítások > Franchise funnel can override them.
MAILCHIMP_API_KEY=change_me-usXX
MAILCHIMP_AUDIENCE_ID=50fc355134
MAILCHIMP_SERVER_PREFIX=us18
# 0 = subscribe immediately; 1 = send Mailchimp confirmation e-mail first.
MAILCHIMP_DOUBLE_OPT_IN=0
# Use a long random secret in production. It encrypts the write-only Mailchimp API key stored from VIR settings.
# Set this BEFORE saving the API key from the VIR admin UI and keep it stable across deployments.
FRANCHISE_SETTINGS_ENCRYPTION_KEY=change_me_long_random_secret

# Generic IMAP credentials used to mirror VIR-sent e-mails into Outlook/Sent.
# If these are omitted, the complaint mailbox credentials below are used as fallback.
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=user@example.com
IMAP_PASS=strong_password
IMAP_SENT_MAILBOX=Sent
IMAP_SENT_SYNC=1
IMAP_TLS_REJECT_UNAUTHORIZED=1

# Dedicated guest complaint mailbox ingestion
COMPLAINT_EMAIL=vendegpanasz@kleoszalon.hu
COMPLAINT_IMAP_HOST=imap.example.com
COMPLAINT_IMAP_PORT=993
COMPLAINT_IMAP_USER=vendegpanasz@kleoszalon.hu
COMPLAINT_IMAP_PASS=strong_password
COMPLAINT_IMAP_MAILBOX=INBOX
COMPLAINT_IMAP_SENT_MAILBOX=Sent
COMPLAINT_IMAP_POLL_SECONDS=120
COMPLAINT_IMAP_MAX_PER_RUN=25
COMPLAINT_SLA_DAYS=5

# Optional salon tablet protection for public guest reviews
GUEST_REVIEW_TABLET_TOKEN=change_me_long_random_token

# Legacy 2018 employee evaluation weights; configurable for exact historical parity
LEGACY_BLACK_POINT_WEIGHT=1
LEGACY_RED_POINT_WEIGHT=-1
LEGACY_RED_X_WEIGHT=-3

# HA readiness metadata. These values must reflect the actual hosting configuration.
RENDER_INSTANCE_COUNT=2
DATABASE_HA_ENABLED=1
