# Auth
# Generate a high-entropy value in Render. Never commit the production value.
JWT_SECRET=change_me_64_plus_random_characters
CODE_EXPIRES_MIN=10

# Security / Cloudflare
# Keep the token server-side only in Render Environment Variables.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Optional aliases supported by the security status endpoint.
CF_API_TOKEN=
CF_ZONE_ID=
# Redis/Render Key Value will be used by the shared limiter when configured in a later rollout.
REDIS_URL=

# CORS
# Comma-separated exact origins. Production should contain only the real frontend/public domains.
CORS_ORIGINS=https://kleoszalon-frontend.onrender.com,https://weblap-o3g6.onrender.com
CORS_ORIGIN=http://localhost:5173

# DB
DATABASE_URL=postgres://user:pass@host:5432/dbname
PG_TIMEZONE=Europe/Budapest
# Keep the application pool intentionally below the database connection ceiling.
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=20000
PG_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=8000

# Mail / VIR internal e-mail
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=strong_password
SMTP_FROM="Kleopátra Szalon <noreply@kleoszalon.hu>"
# If SMTP preflight fails, booking mail stays pending without consuming retry attempts.
BOOKING_PROVIDER_RECHECK_MINUTES=30

# VIR omnichannel communications
# Never commit real provider tokens. Configure these as Render secret environment variables.
COMMUNICATION_DEFAULT_TENANT_ID=
# Long random secret used as a signed callback URL fallback when the platform does not expose the exact raw JSON body.
COMMUNICATION_WEBHOOK_SECRET=change_me_long_random_webhook_secret

# Rakuten Viber Chatbot
VIBER_BOT_TOKEN=
VIBER_BOT_ID=default
VIBER_TENANT_ID=
VIBER_LOCATION_ID=
VIBER_SENDER_NAME=Kleopátra
VIBER_SENDER_AVATAR_URL=
# Production webhook: https://kleoszalon-api-1.onrender.com/api/vir/public/communications/viber?key=<COMMUNICATION_WEBHOOK_SECRET>

# Meta / Facebook Messenger
MESSENGER_PAGE_ID=
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_VERIFY_TOKEN=
MESSENGER_TENANT_ID=
MESSENGER_LOCATION_ID=
META_GRAPH_VERSION=v26.0
# Production callback: https://kleoszalon-api-1.onrender.com/api/vir/public/communications/meta?key=<COMMUNICATION_WEBHOOK_SECRET>

# Mailchimp franchise lead funnel
# Keep the API key server-side only. The frontend never receives it.
# These remain supported as Render/bootstrap fallbacks. VIR > Beállítások > Franchise funnel can override them.
MAILCHIMP_API_KEY=change_me-usXX
MAILCHIMP_AUDIENCE_ID=50fc355134
MAILCHIMP_SERVER_PREFIX=us18
# 0 = subscribe immediately; 1 = send Mailchimp confirmation e-mail first.
MAILCHIMP_DOUBLE_OPT_IN=0
# Use a long random secret in production. It encrypts the write-only Mailchimp API key stored from VIR settings.
# Set this BEFORE saving the API key from the VIR admin UI and keep it stable across deployments.
FRANCHISE_SETTINGS_ENCRYPTION_KEY=change_me_long_random_secret

# Generic IMAP credentials used to mirror VIR-sent e-mails into Outlook/Sent.
# If these are omitted, the complaint mailbox credentials below are used as fallback.
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=user@example.com
IMAP_PASS=strong_password
IMAP_SENT_MAILBOX=Sent
IMAP_SENT_SYNC=1
IMAP_TLS_REJECT_UNAUTHORIZED=1

# Dedicated guest complaint mailbox ingestion
COMPLAINT_EMAIL=vendegpanasz@kleoszalon.hu
COMPLAINT_IMAP_HOST=imap.example.com
COMPLAINT_IMAP_PORT=993
COMPLAINT_IMAP_USER=vendegpanasz@kleoszalon.hu
COMPLAINT_IMAP_PASS=strong_password
COMPLAINT_IMAP_MAILBOX=INBOX
COMPLAINT_IMAP_SENT_MAILBOX=Sent
COMPLAINT_IMAP_POLL_SECONDS=120
COMPLAINT_IMAP_MAX_PER_RUN=25
COMPLAINT_SLA_DAYS=5

# Transaction Lifecycle & Traceability
# Generate a high-entropy random value and store it ONLY as a Render secret.
# It signs the current trace hash outside the database so a DB-only attacker cannot silently rebuild the proof chain.
TRANSACTION_TRACE_HMAC_KEY=change_me_64_plus_random_characters
TRANSACTION_TRACE_HMAC_KEY_ID=render-hmac-v1
# Maximum age of an incomplete transaction lifecycle before forensic SLA breach.
TRANSACTION_TRACE_SLA_MINUTES=240
# Minimum cooldown before repeating the same trace anomaly e-mail.
TRANSACTION_TRACE_ALERT_COOLDOWN_MINUTES=180
# Optional emergency switch. Keep 0/undefined in production.
TRANSACTION_TRACE_DISABLED=0

# Exception Command Center
# Repeat high/critical exception digest notifications no more frequently than this.
EXCEPTION_CENTER_ALERT_COOLDOWN_MINUTES=120
# Emergency switch only. Keep 0/undefined in production; 1 stops automatic 5-minute discovery/sync.
EXCEPTION_CENTER_DISABLED=0

# Optional salon tablet protection for public guest reviews
GUEST_REVIEW_TABLET_TOKEN=change_me_long_random_token

# Legacy 2018 employee evaluation weights; configurable for exact historical parity
LEGACY_BLACK_POINT_WEIGHT=1
LEGACY_RED_POINT_WEIGHT=-1
LEGACY_RED_X_WEIGHT=-3

# HA readiness metadata. These values must reflect the actual hosting configuration.
RENDER_INSTANCE_COUNT=2
DATABASE_HA_ENABLED=1
