{
  "name": "kleoszalon-api",
  "version": "1.0.0",
  "description": "Kleoszalon API - Node.js + TypeScript + Express",
  "private": true,
  "engines": {
    "node": ">=18.18 <21"
  },
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('.nav-build',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.server.json && node scripts/prepare-nav-xsd-assets.mjs && node scripts/copy-nav-build-assets.mjs && node scripts/nav-xsd-smoke.cjs",
    "test": "node --test tests/*.test.js",
    "requirements:check": "node scripts/validate-requirements.mjs && node scripts/validate-operational-requirements.mjs && node scripts/validate-requirement-automation.mjs",
    "requirements:matrix": "node scripts/validate-requirements.mjs --write-matrix && node scripts/validate-operational-requirements.mjs --write-matrix",
    "requirements:evidence": "node scripts/generate-requirement-evidence.mjs",
    "test:requirements-critical": "node --test tests/requirements-critical-automation.contract.test.js",
    "test:financial-integrity": "node --test tests/financial-integrity.contract.test.js",
    "test:workorders": "node --test tests/workorder-stage8.contract.test.js tests/rbac-failclosed.contract.test.js tests/live-runtime-hotfix.contract.test.js",
    "test:saas-isolation": "node scripts/saas-cross-tenant-uat.js",
    "start": "node -r ./scripts/workorder-recipient-env.cjs dist/server.js",
    "seed:demo": "node dist/demo/seedRunner.js",
    "dev": "nodemon --watch src --ext ts --exec \"ts-node --project tsconfig.server.json src/server.ts\""
  },
  "dependencies": {
    "@types/web-push": "^3.6.4",
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.18.0",
    "pg": "^8.16.3",
    "recharts": "^3.8.1",
    "web-push": "^3.6.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.14.11",
    "@types/nodemailer": "^7.0.3",
    "@types/pdfkit": "^0.17.5",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "copyfiles": "^2.4.1",
    "rimraf": "^5.0.7",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  }
}
