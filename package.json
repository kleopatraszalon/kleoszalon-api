{
  "name": "kleoszalon-api",
  "version": "1.0.0",
  "description": "Kleoszalon API - Node.js + TypeScript + Express",
  "private": true,
  "engines": { "node": ">=18.18 <21" },
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.server.json && node -e \"require('fs').cpSync('src/sql','dist/sql',{recursive:true})\"",
    "test": "node --test tests/*.test.js",
    "test:workorders": "node --test tests/workorder-stage8.contract.test.js tests/rbac-failclosed.contract.test.js",
    "start": "node dist/server.js",
    "seed:demo": "node dist/demo/seedRunner.js",
    "dev": "nodemon --watch src --ext ts --exec \"ts-node --project tsconfig.server.json src/server.ts\""
  },
  "dependencies": {
    "axios": "^1.13.2", "bcrypt": "^5.1.1", "bcryptjs": "^2.4.3", "cookie-parser": "^1.4.7", "cors": "^2.8.5", "dotenv": "^16.6.1", "express": "^4.21.1", "html2canvas": "^1.4.1", "jsonwebtoken": "^9.0.2", "jspdf": "^4.2.1", "morgan": "^1.10.1", "multer": "^2.0.2", "node-cron": "^4.2.1", "nodemailer": "^7.0.13", "pdfkit": "^0.18.0", "pg": "^8.16.3", "recharts": "^3.8.1", "xlsx": "^0.18.5", "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36", "@types/bcrypt": "^6.0.0", "@types/bcryptjs": "^2.4.6", "@types/cookie-parser": "^4.2.6", "@types/express": "^5.0.6", "@types/jsonwebtoken": "^9.0.10", "@types/morgan": "^1.9.10", "@types/multer": "^2.0.0", "@types/node": "^25.0.10", "@types/nodemailer": "^7.0.11", "@types/pdfkit": "^0.17.5", "@types/pg": "^8.15.6", "@types/react": "^19.2.2", "@types/react-dom": "^19.2.2", "copyfiles": "^2.4.1", "rimraf": "^5.0.7", "ts-node": "^10.9.2", "typescript": "5.9.3"
  }
}
